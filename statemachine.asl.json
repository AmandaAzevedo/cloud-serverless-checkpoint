{
  "Comment": "Projeto Final: IA (Bedrock) decide a casa + justificativa, com fallback (MathRandom). Orquestra classificação → persistência (e-mail único) → notificação (SES), com retry, rollback e DLQ.",
  "StartAt": "Processar",
  "States": {
    "Processar": {
      "Type": "Map",
      "ItemsPath": "$.alunos",
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "ClassificarComIA",
        "States": {
          "ClassificarComIA": {
            "Type": "Task",
            "Resource": "arn:aws:states:::bedrock:invokeModel",
            "Comment": "O 'Chapéu Seletor' usa um LLM (Amazon Bedrock) para escolher a casa.",
            "Parameters": {
              "ModelId": "${BedrockModelId}",
              "Body": {
                "messages": [
                  {
                    "role": "user",
                    "content": [
                      { "text": "Você é o Chapéu Seletor de Hogwarts. Em UMA frase curta em português, diga a casa do aluno (use exatamente um destes nomes: Grifinória, Sonserina, Corvinal ou Lufa-Lufa) e o motivo. Comece a frase pelo nome da casa. Nome do aluno:" },
                      { "text.$": "$.nome" }
                    ]
                  }
                ],
                "inferenceConfig": { "maxTokens": 200, "temperature": 0.7 }
              }
            },
            "ResultSelector": { "texto.$": "$.Body.output.message.content[0].text" },
            "ResultPath": "$.ia",
            "Retry": [
              { "ErrorEquals": ["Bedrock.ThrottlingException", "Bedrock.ModelTimeoutException"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2.0 }
            ],
            "Catch": [
              { "ErrorEquals": ["States.ALL"], "ResultPath": "$.iaErro", "Next": "SortearFallback" }
            ],
            "Next": "InterpretarIA"
          },
          "InterpretarIA": {
            "Type": "Choice",
            "Comment": "Detecta a casa no texto da IA (tolera markdown/texto extra). Sem casa reconhecida → fallback.",
            "Choices": [
              { "Variable": "$.ia.texto", "StringMatches": "*Grifinória*", "Next": "CasaGrifinoria" },
              { "Variable": "$.ia.texto", "StringMatches": "*Sonserina*", "Next": "CasaSonserina" },
              { "Variable": "$.ia.texto", "StringMatches": "*Corvinal*", "Next": "CasaCorvinal" },
              { "Variable": "$.ia.texto", "StringMatches": "*Lufa*", "Next": "CasaLufaLufa" }
            ],
            "Default": "SortearFallback"
          },
          "CasaGrifinoria": { "Type": "Pass", "Parameters": { "nome.$": "$.nome", "email.$": "$.email", "casa": "Grifinória", "justificativa.$": "$.ia.texto", "origem": "ia" }, "Next": "RamificarPorCasa" },
          "CasaSonserina": { "Type": "Pass", "Parameters": { "nome.$": "$.nome", "email.$": "$.email", "casa": "Sonserina", "justificativa.$": "$.ia.texto", "origem": "ia" }, "Next": "RamificarPorCasa" },
          "CasaCorvinal": { "Type": "Pass", "Parameters": { "nome.$": "$.nome", "email.$": "$.email", "casa": "Corvinal", "justificativa.$": "$.ia.texto", "origem": "ia" }, "Next": "RamificarPorCasa" },
          "CasaLufaLufa": { "Type": "Pass", "Parameters": { "nome.$": "$.nome", "email.$": "$.email", "casa": "Lufa-Lufa", "justificativa.$": "$.ia.texto", "origem": "ia" }, "Next": "RamificarPorCasa" },
          "SortearFallback": {
            "Type": "Pass",
            "Comment": "IA indisponível → sorteio aleatório (degradação graciosa).",
            "Parameters": {
              "nome.$": "$.nome",
              "email.$": "$.email",
              "indice.$": "States.MathRandom(0, 3)"
            },
            "Next": "EscolherCasaFallback"
          },
          "EscolherCasaFallback": {
            "Type": "Pass",
            "Parameters": {
              "nome.$": "$.nome",
              "email.$": "$.email",
              "casa.$": "States.ArrayGetItem(States.Array('Grifinória', 'Sonserina', 'Corvinal', 'Lufa-Lufa'), $.indice)",
              "justificativa": "Seleção por sorteio (IA indisponível).",
              "origem": "aleatorio"
            },
            "Next": "RamificarPorCasa"
          },
          "RamificarPorCasa": {
            "Type": "Choice",
            "Choices": [
              { "Variable": "$.casa", "StringEquals": "Grifinória", "Next": "LemaGrifinoria" },
              { "Variable": "$.casa", "StringEquals": "Sonserina", "Next": "LemaSonserina" },
              { "Variable": "$.casa", "StringEquals": "Corvinal", "Next": "LemaCorvinal" }
            ],
            "Default": "LemaLufaLufa"
          },
          "LemaGrifinoria": { "Type": "Pass", "Result": { "lema": "Coragem e determinação!" }, "ResultPath": "$.ramo", "Next": "Persistir" },
          "LemaSonserina": { "Type": "Pass", "Result": { "lema": "Ambição e astúcia!" }, "ResultPath": "$.ramo", "Next": "Persistir" },
          "LemaCorvinal": { "Type": "Pass", "Result": { "lema": "Sabedoria e engenho!" }, "ResultPath": "$.ramo", "Next": "Persistir" },
          "LemaLufaLufa": { "Type": "Pass", "Result": { "lema": "Lealdade e trabalho!" }, "ResultPath": "$.ramo", "Next": "Persistir" },
          "Persistir": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "${TableName}",
              "Item": {
                "email": { "S.$": "$.email" },
                "nome": { "S.$": "$.nome" },
                "casa": { "S.$": "$.casa" },
                "justificativa": { "S.$": "$.justificativa" },
                "origem": { "S.$": "$.origem" },
                "notificado": { "BOOL": false },
                "criado_em": { "S.$": "$$.State.EnteredTime" }
              },
              "ConditionExpression": "attribute_not_exists(email)"
            },
            "ResultPath": null,
            "Retry": [
              { "ErrorEquals": ["DynamoDB.InternalServerError", "DynamoDB.ThrottlingException", "DynamoDB.ProvisionedThroughputExceededException"], "IntervalSeconds": 1, "MaxAttempts": 3, "BackoffRate": 2.0 }
            ],
            "Catch": [
              { "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "ResultPath": "$.erro", "Next": "EmailDuplicado" }
            ],
            "Next": "Notificar"
          },
          "Notificar": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:ses:sendEmail",
            "Parameters": {
              "Source": "${SenderEmail}",
              "Destination": { "ToAddresses.$": "States.Array($.email)" },
              "Message": {
                "Subject": { "Data": "Chapéu Seletor" },
                "Body": {
                  "Text": {
                    "Data.$": "States.Format('Ola {}! O Chapeu Seletor escolheu a casa {}. {} Motivo: {}', $.nome, $.casa, $.ramo.lema, $.justificativa)"
                  }
                }
              }
            },
            "ResultPath": null,
            "Retry": [
              { "ErrorEquals": ["Ses.ThrottlingException", "Lambda.ServiceException"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2.0 }
            ],
            "Catch": [
              { "ErrorEquals": ["States.ALL"], "ResultPath": "$.erro", "Next": "DesfazerCadastro" }
            ],
            "Next": "MarcarNotificado"
          },
          "MarcarNotificado": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Parameters": {
              "TableName": "${TableName}",
              "Key": { "email": { "S.$": "$.email" } },
              "UpdateExpression": "SET notificado = :v",
              "ExpressionAttributeValues": { ":v": { "BOOL": true } }
            },
            "ResultPath": null,
            "Retry": [
              { "ErrorEquals": ["DynamoDB.InternalServerError", "DynamoDB.ThrottlingException", "DynamoDB.ProvisionedThroughputExceededException"], "IntervalSeconds": 1, "MaxAttempts": 3, "BackoffRate": 2.0 }
            ],
            "Catch": [
              { "ErrorEquals": ["States.ALL"], "ResultPath": "$.erro", "Next": "Sucesso" }
            ],
            "Next": "Sucesso"
          },
          "DesfazerCadastro": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:deleteItem",
            "Comment": "Rollback: o e-mail falhou, então o cadastro é desfeito.",
            "Parameters": {
              "TableName": "${TableName}",
              "Key": { "email": { "S.$": "$.email" } }
            },
            "ResultPath": null,
            "Retry": [
              { "ErrorEquals": ["DynamoDB.InternalServerError", "DynamoDB.ThrottlingException", "DynamoDB.ProvisionedThroughputExceededException"], "IntervalSeconds": 1, "MaxAttempts": 3, "BackoffRate": 2.0 }
            ],
            "Catch": [
              { "ErrorEquals": ["States.ALL"], "ResultPath": "$.erro", "Next": "NotificacaoParaDLQ" }
            ],
            "Next": "NotificacaoParaDLQ"
          },
          "NotificacaoParaDLQ": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sqs:sendMessage",
            "Parameters": {
              "QueueUrl": "${DlqUrl}",
              "MessageBody.$": "$"
            },
            "ResultPath": null,
            "Next": "CadastroCancelado"
          },
          "CadastroCancelado": {
            "Type": "Pass",
            "Parameters": {
              "nome.$": "$.nome",
              "email.$": "$.email",
              "casa.$": "$.casa",
              "justificativa.$": "$.justificativa",
              "origem.$": "$.origem",
              "status": "cancelado",
              "motivo": "Falha no envio do e-mail; cadastro desfeito.",
              "enviadoParaDLQ": true
            },
            "End": true
          },
          "Sucesso": {
            "Type": "Pass",
            "Parameters": {
              "nome.$": "$.nome",
              "email.$": "$.email",
              "casa.$": "$.casa",
              "lema.$": "$.ramo.lema",
              "justificativa.$": "$.justificativa",
              "origem.$": "$.origem",
              "status": "cadastrado",
              "notificado": true
            },
            "End": true
          },
          "EmailDuplicado": {
            "Type": "Pass",
            "Parameters": {
              "email.$": "$.email",
              "status": "duplicado",
              "mensagem": "E-mail já cadastrado."
            },
            "End": true
          }
        }
      },
      "End": true
    }
  }
}
